{
  "name": "etf-compare",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg server.js --targets node18-win-x64 --output dist/etf-compare.exe --assets public/**"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.2",
    "fast-xml-parser": "^4.3.4",
    "multer": "^1.4.5-lts.1",
    "open": "^8.4.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": ["public/**/*", "*.db"],
    "targets": ["node18-win-x64"]
  }
}
